; model.v.pica — static models (doodads, WMO groups, merged batches, the sky models, markers).
; 6.70: shorter (37 -> 28 instructions): the per-draw work is done once on the CPU (vs_fold.hpp, render.cpp ModelVs):
;   mvp       = projection * modelView * T(posOffset) * S(posScale)   -> clip position straight from the stored shorts
;   modelView = modelView * T(posOffset) * S(posScale)                -> rows 0..2: the view-space point for the fog distance
;   uvRowA/B  : the u, v terms already times the uv scale; lightDir already / 127 (the normal's bytes are used as they are)
; Outputs as before: position, texcoord0 = (u', v', 0, 1), colour = (light, fog visibility, 0, 1).

.fvec mvp[4], modelView[4]
.fvec lightDir          ; xyz = direction to the sun in MODEL space, divided by 127
.fvec lightParams       ; x = ambient, y = diffuse, w = minimum brightness (1 = unlit)
.fvec fogParams         ; x = 1/(end-start), y = end/(end-start)
.fvec uvRowA            ; u' = uvRowA . (u, v, 1)   (identity: uvScale, 0, 0)
.fvec uvRowB            ; v' = uvRowB . (u, v, 1)   (identity: 0, uvScale, 0)

.constf myconst(0.0, 1.0, 0.0, 0.0)
.alias  zeros   myconst.xxxx
.alias  ones    myconst.yyyy
.alias  zeroOne myconst.xxxy   ; (0, 0, 0, 1): written to .zw gives z = 0, w = 1

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias innrm v1
.alias intc  v2

.proc main
	; the stored point with w = 1
	mov r0.xyz, inpos.xyz
	mov r0.w, ones

	; clip position
	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; view-space point (fog distance)
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0

	; texture coordinate through the (scaled) transform rows
	mov r2.xy, intc.xy
	mov r2.z, ones
	dp3 outtc0.x, uvRowA, r2
	dp3 outtc0.y, uvRowB, r2
	mov outtc0.zw, zeroOne

	; light = clamp(max(min, ambient + diffuse * max(0, N.L)), 0..1) -> colour red
	dp3 r4.x, lightDir, innrm
	max r4.x, zeros, r4.x
	mul r4.x, lightParams.yyyy, r4.x
	add r4.x, lightParams.xxxx, r4.x
	max r4.x, lightParams.wwww, r4.x
	min outclr.x, ones, r4.x

	; fog visibility = clamp(fogY - dist * fogX) -> colour green
	dp3 r5.x, r1, r1
	rsq r5.y, r5.x
	mul r5.x, r5.x, r5.y          ; dist = d2 * rsq(d2)
	mul r5.x, fogParams.xxxx, r5.x
	add r5.x, fogParams.yyyy, -r5.x
	max r5.x, zeros, r5.x
	min outclr.y, ones, r5.x
	mov outclr.zw, zeroOne

	end
.end
