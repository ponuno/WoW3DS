; Skinned creature vertex shader (CMDL, W3dSkinVertex): 2 bone influences per vertex.
; v0 = s16 position (bind pose), v1 = s8 normal, v2 = s16 uv,
; v3 = u8 (bone0 * 3, bone1 * 3, weight0, weight1)  -- palette-local bone rows
; bones[] holds the current palette: 3 rows (x, y, z of a 3x4 matrix) per bone,
; mapping bind-pose model space to animated model space (see w3d_anim.h).
; Output colour as in model.v.pica: x = light, y = fog visibility, w = 1.

.fvec projection[4], modelView[4]
.fvec posScale          ; xyz = position scale, w = uv scale
.fvec posOffset         ; xyz = position offset
.fvec lightDir          ; xyz = direction to the sun in MODEL space (normalised)
.fvec lightParams       ; x = ambient, y = diffuse, w = minimum brightness (1 = unlit)
.fvec fogParams         ; x = 1/(end-start), y = end/(end-start)
.fvec bones[72]         ; W3D_PALETTE_BONES * 3

.constf myconst(0.0, 1.0, 0.007874015748, 0.00392156862745)
.alias  zeros   myconst.xxxx
.alias  ones    myconst.yyyy
.alias  inv127  myconst.zzzz
.alias  inv255  myconst.wwww

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos  v0
.alias innrm  v1
.alias intc   v2
.alias inbone v3

.proc main
	; a single mova for both indices (two consecutive mova instructions hang the PICA),
	; followed by unrelated work before a0 is first used
	mova a0.xy, inbone.xy

	mul r0.xyz, posScale.xyz, inpos.xyz
	add r0.xyz, posOffset.xyz, r0.xyz
	mov r0.w, ones
	mul r7.xyz, inv127, innrm.xyz
	mov r7.w, zeros
	mul r8, inv255, inbone          ; r8.z = weight0, r8.w = weight1

	; bone 0
	dp4 r1.x, bones[a0.x], r0
	dp4 r1.y, bones[a0.x+1], r0
	dp4 r1.z, bones[a0.x+2], r0
	dp3 r2.x, bones[a0.x], r7
	dp3 r2.y, bones[a0.x+1], r7
	dp3 r2.z, bones[a0.x+2], r7
	; bone 1
	dp4 r3.x, bones[a0.y], r0
	dp4 r3.y, bones[a0.y+1], r0
	dp4 r3.z, bones[a0.y+2], r0
	dp3 r4.x, bones[a0.y], r7
	dp3 r4.y, bones[a0.y+1], r7
	dp3 r4.z, bones[a0.y+2], r7

	; blend: p = p0 * w0 + p1 * w1 (weights sum to 1)
	mul r1.xyz, r8.zzzz, r1.xyz
	mul r3.xyz, r8.wwww, r3.xyz
	add r0.xyz, r1.xyz, r3.xyz
	mov r0.w, ones
	mul r2.xyz, r8.zzzz, r2.xyz
	mul r4.xyz, r8.wwww, r4.xyz
	add r7.xyz, r2.xyz, r4.xyz

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul r2, posScale.wwww, intc
	mov outtc0, r2

	; light = clamp(ambient + diffuse * max(0, n.L / |n|), unlitFloor, 1)
	dp3 r4.y, r7, r7
	rsq r4.y, r4.y
	mul r7.xyz, r4.yyyy, r7.xyz
	dp3 r4.x, lightDir, r7
	max r4.x, zeros, r4.x
	mul r4.x, lightParams.yyyy, r4.x
	add r4.x, lightParams.xxxx, r4.x
	max r4.x, lightParams.wwww, r4.x
	min r4.x, ones, r4.x

	; fog visibility from the view-space distance
	dp3 r5.x, r1, r1
	rsq r5.y, r5.x
	mul r5.x, r5.x, r5.y
	mul r5.x, fogParams.xxxx, r5.x
	add r5.x, fogParams.yyyy, -r5.x
	max r5.x, zeros, r5.x
	min r5.x, ones, r5.x

	mov r6, zeros
	mov r6.x, r4.x
	mov r6.y, r5.x
	mov r6.w, ones
	mov outclr, r6
	end
.end
