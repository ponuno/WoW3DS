; UI vertex shader (UI stage 1): both screens' 2D quads with vertex colour.
; v0 = s16 position (pixels), v1 = s16 uv (texels), v2 = u8 colour (0..255)
; Output: position through the orthographic projection, uv * uvScale + uvOffset (texels -> PICA 0..1 with t = 1 at the
; top row), colour / 255.

.fvec projection[4]
.fvec uvScale           ; x = 1/width, y = -1/height
.fvec uvOffset          ; x = 0, y = 1

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.0)
.alias  inv255  myconst.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intc  v1
.alias inclr v2

.proc main
	mov r0.xy, inpos.xy
	mov r0.zw, myconst.xy

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mul r1, uvScale, intc
	add r1, uvOffset, r1
	mov outtc0, r1

	mul outclr, inv255, inclr
	end
.end
